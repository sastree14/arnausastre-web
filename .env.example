# SMTP credentials used by app/api/contact/route.ts to send contact-form
# submissions. Copy this file to .env.local for local development, and add
# the same variables in Vercel → Project → Settings → Environment Variables
# for production.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional — defaults to arnau.sastre@sc-analytics.io if not set.
CONTACT_TO_EMAIL=arnau.sastre@sc-analytics.io
