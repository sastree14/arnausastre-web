{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sc-analytics.io/schemas/visual_publication_plan.schema.json",
  "title":"SC-Analytics Visual Publication Plan",
  "type":"object",
  "additionalProperties":false,
  "required":["plan_id","content_object_id","channel","format_key","requested_visual_language","candidate_count","status","created_at","updated_at"],
  "properties":{
    "plan_id":{"type":"string","minLength":1},
    "content_object_id":{"type":"string"},
    "channel":{"enum":["linkedin","website_article","website_project","marketplace_project"]},
    "format_key":{"enum":["carousel","dataviz","architecture","before_after"]},
    "requested_visual_language":{"enum":["AUTO","A","B","C","D"]},
    "candidate_count":{"type":"integer","minimum":1,"maximum":3},
    "plan_json":{"type":"object"},
    "status":{"enum":["planning","ready","needs_review","archived"]},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"}
  }
}
